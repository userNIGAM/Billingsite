# Backend origin that `/api/*` is proxied to by next.config.mjs (no /api suffix).
# Defaults: http://localhost:5000 in dev, https://billingsite.onrender.com in production.
BACKEND_URL=http://localhost:5000

# Must match COOKIE_NAME on the backend (default canteen_token).
# COOKIE_NAME=canteen_token

# Optional: call the API directly instead of through the `/api` proxy.
# Leave this UNSET in production — a direct cross-site call makes the auth
# cookie third-party, and login will not stick.
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
