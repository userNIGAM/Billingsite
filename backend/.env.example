# ---- Server ----
NODE_ENV=development
PORT=5000
TZ=Asia/Kathmandu

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/canteen-khata
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/canteen-khata
MONGODB_URI=mongodb://127.0.0.1:27017/canteen-khata

# ---- Auth ----
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
# One-time token used by POST /api/auth/setup to create the first admin.
# Generate a random value, use it once, then rotate/remove it.
ADMIN_SETUP_TOKEN=replace-this-with-a-random-setup-token

# ---- Frontend / CORS ----
# URL of the frontend. Always allowed by CORS.
# Local: http://localhost:3000   Live (Render): https://billingsite-bay.vercel.app
FRONTEND_URL=http://localhost:3000
# Optional extra comma-separated origins (e.g. a Vercel preview URL).
CORS_ORIGIN=

# ---- Cookies ----
COOKIE_NAME=canteen_token
